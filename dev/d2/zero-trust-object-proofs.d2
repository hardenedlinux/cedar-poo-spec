  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Zero Trust: object composition and publication assurance",
  "kind": "proof-reading-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "Which original requirements and publication frontiers do the actual Contracts preserve?",
      "focusRefs": [
        "sysml",
        "core"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/zero-trust-object-proofs.d2",
