vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1700,
  "primary": "purpose",
  "themes": [
    "editorial",
    "comfortable"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Keep the parent rule; retire the old publication",
  "kind": "proof-reading-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "What prevents weaker children, duplicate use and reused reviews?",
      "focusRefs": [
        "sysml",
        "core"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/zero-trust-object-proofs.d2",
    "sysml": "dev/sysml/zero-trust-proofs.sysml",
    "core": "CedarPooSpec/ZeroTrust/Model.lean",
    "profileSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "sessionSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "counterSource": "Tests/ZeroTrust/ProfileObject.lean",
    "joinedSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "preservedSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "prefixSource": "CedarPooSpec/Gateway/ZeroTrust.lean",
    "continuingSource": "CedarPooSpec/Gateway/ZeroTrust.lean",
    "deltaHostSource": "CedarPooSpec/Gateway/PublicationReview.lean",
    "frontierSource": "CedarPooSpec/Gateway/PublicationReview.lean",
    "successiveSource": "CedarPooSpec/Gateway/PublicationReview.lean",
    "finalRollbackSource": "Tests/Gateway/PublicationReview.lean"
  },
  "copy": {
    "description": "Three arguments: inherited rules, ongoing consumption, and publication epochs.",
    "status": "PROOF marks a checked lemma dependency; CONTEXT explains the model. Authentic readers and every-writer ordering remain premises."
  },
  "presentation": {
    "notation": "assurance",
    "columns": 1,
    "groups": [
      {
        "title": "Retain both object rules",
        "icon": "branch",
        "subjects": [
          "profile",
          "session",
          "counter",
          "joined",
          "preserved"
        ],
        "columns": 5
      },
      {
        "title": "Do not consume twice",
        "icon": "registry",
        "subjects": [
          "prefix",
          "continuing"
        ],
        "columns": 2
      },
      {
        "title": "Advance the publication frontier",
        "icon": "gate",
        "subjects": [
          "deltaHost",
          "frontier",
          "finalRollback",
          "successive"
        ],
        "columns": 4
      }
    ]
  },
  "sysml": {
    "source": "dev/sysml/zero-trust-proofs.sysml",
    "view": "ZeroTrustProofs::objects",
    "bindings": {
      "profile": {
        "name": "ZeroTrustProofs::profile",
        "icon": "puzzle"
      },
      "session": {
        "name": "ZeroTrustProofs::session",
        "icon": "request"
