}}}
profile: "Profile\nSelected rule implies original"
session: "Session / Contract\nRead the actual source object"
counter: "Root-only check loses a rule\nRoot ≤ 10; parent ≤ 5\nValue 8 passes root, fails parent"
joined: "Require both rules\nParent AND selected\nAt the same effect and view"
preserved: "Composition keeps both\nIf: composed acceptance holds\nThen: actual reads + both rules"
prefix: "Retain the consumed prefix\nAssume: current acceptance\nAnd: authentic parent + history"
continuing: "Continue without reconsuming\nIf: composed use is accepted\nThen: current + prefix + parent\nOriginal operation is refused again"
profile -> session: "Typed reads"
profile -> counter: "Parent-loss counterexample"
session -> joined: "Retain both Sessions"
counter -> joined: "Motivates conjunction"
joined -> preserved: "Accepted conjunction"
preserved -> continuing: "Keeps parent rule"
prefix -> continuing: "Current + prefix"

deltaHost: "Bind the actual frontier\nRequired pre/post epoch reader"
frontier: "Final installs its successor\nIf: an actual Delta Final exists\nThen: epochs match its frontier"
successive: "Later Finals advance\nIf: two Finals + monotone Run\nThen: review epochs increase"
finalRollback: "Whole-reader rollback fails\nRestore every authority reader\nThe same Final can apply again"
deltaHost -> frontier: "Pre/post binding"
frontier -> successive: "Frontier law"
finalRollback -> successive: "Every writer required"
