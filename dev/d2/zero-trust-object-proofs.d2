      },
      {
        "title": "Current use and consumption",
        "subjects": [
          "prefix",
          "continuing"
        ],
        "columns": 1
      },
      {
        "title": "Publication frontier Contract",
        "subjects": [
          "deltaHost",
          "frontier",
          "successive",
          "finalRollback"
        ],
        "columns": 1
      }
    ]
  },
  "sysml": {
    "source": "dev/sysml/zero-trust-proofs.sysml",
    "view": "ZeroTrustProofs::objects",
    "bindings": {
      "profile": {
        "name": "ZeroTrustProofs::profile",
        "icon": "library"
      },
      "session": {
