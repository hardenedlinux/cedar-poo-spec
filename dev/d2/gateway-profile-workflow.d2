vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1900,
  "primary": "purpose",
  "themes": [
    "blueprint",
    "comfortable"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Gateway: can this request use the published profile?",
  "kind": "workflow",
  "questions": [
    {
      "ref": "purpose",
      "text": "Where does the request continue, and where must it stop?",
      "focusRefs": [
        "sysml",
        "sourceCode"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/gateway-profile-workflow.d2",
    "sysml": "dev/sysml/gateway-activities.sysml",
    "sourceCode": "CedarPooSpec/Gateway/ProfileAdmission.lean",
    "objects": "CedarPooSpec/Gateway/ProfileObject.lean",
    "admission": "CedarPooSpec/Gateway/Admission.lean"
  },
  "copy": {
    "description": "Follow the arrows from the profile to the bound receipt. Each check has an explicit refusal route.",
    "status": "Pure admission, not dispatch. The Host supplies the authoritative publication; Lean checks the API bindings."
  },
  "presentation": {
    "notation": "workflow",
    "activity": {
      "entry": "stepSession",
      "decisions": [
        "stepSession",
        "stepCapture",
        "stepAuthorize",
        "stepBind"
      ],
      "terminals": [
        "stepAccepted",
        "stepRefused"
      ],
      "direction": "RIGHT"
    }
  },
  "sysml": {
    "source": "dev/sysml/gateway-activities.sysml",
    "view": "GatewayProfileFlow::overview",
    "bindings": {
      "stepSession": {
        "name": "GatewayProfileFlow::stepSession",
        "icon": "current"
      },
      "stepCapture": {
        "name": "GatewayProfileFlow::stepCapture",
        "icon": "request"
      },
      "stepAuthorize": {
        "name": "GatewayProfileFlow::stepAuthorize",
        "icon": "current"
      },
      "stepBind": {
        "name": "GatewayProfileFlow::stepBind",
        "icon": "capture"
      },
      "stepAccepted": {
        "name": "GatewayProfileFlow::stepAccepted",
        "icon": "evidence"
      },
      "stepRefused": {
        "name": "GatewayProfileFlow::stepRefused",
        "icon": "gate"
      }
    }
  },
  "proofs": {
    "namespace": "GatewayProfileFlow"
  }
}
|
}}}
stepSession: "Profile still fits?\nOriginal checks retained"
stepCapture: "Profile selected?\nRead the actual object"
stepAuthorize: "Allowed now?\nCurrent context + Cedar"
stepBind: "Same publication?\nExact profile + context"
stepAccepted: "Bound receipt\nReady for final-use checks"
stepRefused: "Stop\nReturn the typed error"
stepSession -> stepCapture: "fits"
stepSession -> stepRefused: "invalid"
stepCapture -> stepAuthorize: "selected"
stepCapture -> stepRefused: "missing"
stepAuthorize -> stepBind: "allow"
stepAuthorize -> stepRefused: "deny / error"
stepBind -> stepAccepted: "match"
stepBind -> stepRefused: "changed"
