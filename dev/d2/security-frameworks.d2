vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1400,
  "primary": "purpose",
  "themes": [
    "blueprint",
    "compact"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Zero Trust: rules meet the actual application",
  "kind": "responsibility-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "How do current-use requirements reach a Gateway?",
      "focusRefs": [
        "sysml",
        "lean"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/security-frameworks.d2",
    "sysml": "dev/sysml/security-frameworks.sysml",
    "lean": "CedarPooSpec/ZeroTrust/ProfileObject.lean"
  },
  "copy": {
    "description": "Follow the dependency arrows. Object interpretation retains the required parent rule.",
    "status": "Logical responsibilities, not a runtime call sequence. The application supplies authenticated facts and effect ordering."
  },
  "presentation": {
    "notation": "dependencies",
    "columns": 2
  },
  "sysml": {
    "source": "dev/sysml/security-frameworks.sysml",
    "view": "CedarFrameworks::overview",
    "bindings": {
      "core": {
        "name": "CedarFrameworks::core",
        "icon": "current"
      },
      "authorization": {
        "name": "CedarFrameworks::authorization",
        "icon": "rules"
      },
      "poo": {
        "name": "CedarFrameworks::poo",
        "icon": "branch"
      },
      "gateway": {
        "name": "CedarFrameworks::gateway",
        "icon": "gate"
      },
      "other": {
        "name": "CedarFrameworks::other",
        "icon": "puzzle"
      }
    }
  }
}
|
}}}
core: "Zero Trust core\nCurrent-use requirements"
authorization: "Authorization\nCedar + schema-bound Delta"
poo: "POO interpretation\nRequired parent + selected rule"
gateway: "Gateway\nCurrent admission + consumption"
other: "Other applications\nOwn effects + own views"
core -> poo: "Requirements"
poo -> other: "Specialization"
poo -> gateway: "Parent rule"
authorization -> gateway: "Policy assessment"
