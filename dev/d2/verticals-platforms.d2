    "financeSource": "CedarPooSpec/Vertical/FinancialServices/README.org",
    "awsSource": "CedarPooSpec/Platform/AWS/AgentCore/README.org",
    "googleSource": "CedarPooSpec/Platform/Google/README.org"
  },
  "copy": {
    "description": "Two different choices: what must be controlled, and where it is integrated.",
    "status": "These are the implemented library families. Other scenario industries remain Examples."
  },
  "presentation": {
    "notation": "catalogue",
    "columns": 1,
    "groups": [
      {
        "title": "What must be controlled?",
        "icon": "hospital",
        "subjects": [
