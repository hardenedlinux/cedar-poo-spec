          "finance"
        ],
        "columns": 2
      },
      {
        "title": "Where is it integrated?",
        "icon": "cloud",
        "subjects": [
          "aws",
          "google"
        ],
        "columns": 2
      }
    ]
  },
  "sysml": {
    "source": "dev/sysml/architecture.sysml",
    "view": "CedarArchitecture::verticalsPlatforms",
