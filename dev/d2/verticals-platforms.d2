    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Industry rules and platform adapters",
  "kind": "responsibility-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "Am I choosing an industry rule or a platform integration?",
      "focusRefs": [
        "sysml",
        "library"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/verticals-platforms.d2",
    "sysml": "dev/sysml/architecture.sysml",
    "library": "CedarPooSpec.lean",
