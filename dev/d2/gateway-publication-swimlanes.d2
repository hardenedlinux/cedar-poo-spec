}}}
stepCapture: "Request a captured ticket\nAuthority::capture\nOwner identity + current generation"
stepCall: "Request publication\nAuthority::publish(ticket, lost, observe)\nTicket is not commit permission"
stepCheck: "Refuse missing / foreign / stale\nAcquire current Mutex after owner check\nRead current image and current review"
stepAdmit: "Prepare the successor image\nImage::step; refuse Denied / Exhausted\nNo observer on any refused path"
stepInstall: "Install image + generation\nChecked generation increment\nThe same Mutex remains held"
stepObserve: "Invoke observe(&current.image)\nCallback executes inside the Mutex\nCompeting control/register writers wait"
stepReturn: "Return Committed(reply)\nA lost reply may remain unknown\nNot proof of external delivery"
stepCapture -> stepCall: "ticket passed to caller"
stepCall -> stepCheck: "enter publish; error branches return immediately"
stepCheck -> stepAdmit: "current ticket only"
stepAdmit -> stepInstall: "admitted image + checked counter only"
stepInstall -> stepObserve: "installed state; lock retained"
stepObserve -> stepReturn: "callback returns; then release lock"
