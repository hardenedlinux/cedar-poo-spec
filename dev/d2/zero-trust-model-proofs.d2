vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1700,
  "primary": "purpose",
  "themes": [
    "editorial",
    "comfortable"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Why must each use be checked again?",
  "kind": "proof-reading-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "What follows from the assumptions, and what breaks without them?",
      "focusRefs": [
        "sysml",
        "core"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/zero-trust-model-proofs.d2",
    "sysml": "dev/sysml/zero-trust-proofs.sysml",
    "core": "CedarPooSpec/ZeroTrust/Model.lean",
    "requiredSource": "CedarPooSpec/ZeroTrust/Composition.lean",
    "refinementSource": "CedarPooSpec/ZeroTrust/Composition.lean",
    "observedSource": "CedarPooSpec/ZeroTrust/Continuous.lean",
    "mediatedSource": "CedarPooSpec/ZeroTrust/Continuous.lean",
    "usageSource": "CedarPooSpec/ZeroTrust/UsageControl.lean",
    "recoverySource": "CedarPooSpec/ZeroTrust/UsageControl.lean",
    "meaningsSource": "CedarPooSpec/ZeroTrust/Model.lean",
    "monotoneSource": "CedarPooSpec/ZeroTrust/Continuous.lean",
    "retiredSource": "CedarPooSpec/ZeroTrust/Continuous.lean",
    "rollbackSource": "Tests/ZeroTrust/Functional.lean"
  },
  "copy": {
    "description": "Read one argument per row. PROOF marks a checked lemma dependency; CONTEXT is explanatory.",
    "status": "Host assumptions are not implemented by a theorem. Exact Lean declarations and proof dependencies remain in the linked source receipt."
  },
  "presentation": {
    "notation": "assurance",
    "columns": 1,
    "groups": [
      {
        "title": "Assume and strengthen",
        "icon": "registrar",
        "subjects": [
          "meanings",
          "required",
          "refinement"
        ],
        "columns": 3
      },
      {
        "title": "Check each use",
        "icon": "current",
        "subjects": [
          "observed",
          "mediated",
          "usage",
          "recovery"
        ],
        "columns": 4
      },
      {
        "title": "Keep old observations retired",
        "icon": "recovery",
        "subjects": [
          "monotone",
          "retired",
          "rollback"
        ],
        "columns": 3
      }
    ]
  },
  "sysml": {
    "source": "dev/sysml/zero-trust-proofs.sysml",
    "view": "ZeroTrustProofs::model",
    "bindings": {
      "required": {
        "name": "ZeroTrustProofs::required",
        "icon": "rules"
      },
      "refinement": {
        "name": "ZeroTrustProofs::refinement",
        "icon": "branch"
      },
      "observed": {
        "name": "ZeroTrustProofs::observed",
        "icon": "current"
      },
      "mediated": {
        "name": "ZeroTrustProofs::mediated",
        "icon": "gate"
      },
      "usage": {
        "name": "ZeroTrustProofs::usage",
        "icon": "observer"
      },
      "recovery": {
        "name": "ZeroTrustProofs::recovery",
        "icon": "recovery"
      },
      "meanings": {
        "name": "ZeroTrustProofs::meanings",
        "icon": "registrar"
      },
      "monotone": {
        "name": "ZeroTrustProofs::monotone",
        "icon": "pending"
      },
      "retired": {
        "name": "ZeroTrustProofs::retired",
        "icon": "evidence"
      },
      "rollback": {
        "name": "ZeroTrustProofs::rollback",
        "icon": "warning"
      }
    }
  },
  "proofs": {
    "namespace": "ZeroTrustProofs"
  }
}
|
}}}
required: "Core requirement\nIdentity + permission + freshness\nCommit + retain unknowns\nNo revocation + mediated effect"
refinement: "Keep the original rule\nIf: stronger requirement holds\nThen: the full core still holds"
observed: "Reject stale observations\nIf: bound generation changes\nThen: use is blocked"
mediated: "Recheck each effect\nIf: mediated step is accepted\nThen: source-state checks hold"
usage: "Retain checks during use\nIf: usage step is accepted\nThen: the core still holds"
recovery: "Recheck after recovery\nIf: recovery + ongoing admission\nThen: current + committed + retained"
meanings: "Authentic inputs\nAssume: real facts + ordered IO"
required -> refinement: "Original core"
required -> observed: "Observation binding"
required -> mediated: "Per-effect core"
mediated -> usage: "Mediated step"
usage -> recovery: "Retains core"
meanings -> required: "Authentic meanings"
monotone: "Keep generations ordered\nIf: every writer preserves order\nThen: a finite Run preserves it"
retired: "Old observations stay refused\nIf: old cut + monotone Run\nThen: later callbacks reject it"
rollback: "Rollback breaks retirement\nRewind the authority generation\nThe old observation can pass again"
meanings -> monotone: "Every writer"
monotone -> retired: "Generation order"
rollback -> retired: "Monotone recovery required"
