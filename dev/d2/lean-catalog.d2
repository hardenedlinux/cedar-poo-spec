vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1200,
  "primary": "purpose",
  "themes": [
    "blueprint",
    "compact"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "What does the native catalog contain?",
  "kind": "catalog-overview",
  "questions": [
    {
      "ref": "purpose",
      "text": "How many entries use each transport form?",
      "focusRefs": [
        "sysml",
        "producer"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/lean-catalog.d2",
    "sysml": "dev/sysml/lean-catalog.sysml",
    "producer": "CedarPooSpec/Transport/SourceCatalog.lean"
  },
  "copy": {
    "description": "Counts come from the captured Lean catalog. Bar lengths share the same zero baseline.",
    "status": "Transport inventory, not industry coverage or issued permissions."
  },
  "presentation": {
    "notation": "bars",
    "columns": 2
  },
  "sysml": {
    "source": "dev/sysml/lean-catalog.sysml",
    "view": "LeanCatalog::overview",
    "bindings": {
      "raw": {
        "name": "LeanCatalog::group0",
        "icon": "request"
      },
      "schema_bound": {
        "name": "LeanCatalog::group1",
        "icon": "rules"
      },
      "evolution": {
        "name": "LeanCatalog::group2",
        "icon": "recovery"
      },
      "artifacts": {
        "name": "LeanCatalog::group3",
        "icon": "evidence"
      },
      "data": {
        "name": "LeanCatalog::group4",
        "icon": "registry"
      }
    }
  },
  "catalog": {
    "counts": {
      "raw": {
        "expression": "LeanCatalog::group0Count",
        "category": "raw",
        "one": "catalog entry",
        "other": "catalog entries"
      },
      "schema_bound": {
        "expression": "LeanCatalog::group1Count",
        "category": "schema-bound",
        "one": "catalog entry",
        "other": "catalog entries"
      },
      "evolution": {
        "expression": "LeanCatalog::group2Count",
        "category": "evolution",
        "one": "catalog entry",
        "other": "catalog entries"
      },
      "artifacts": {
        "expression": "LeanCatalog::group3Count",
        "category": "artifacts",
        "one": "catalog entry",
        "other": "catalog entries"
      },
      "data": {
        "expression": "LeanCatalog::group4Count",
        "category": "data",
        "one": "catalog entry",
        "other": "catalog entries"
      }
    }
  }
}
|
}}}
raw: Raw manifests
schema_bound: Schema-bound manifests
evolution: Revision evolution
artifacts: Policy artifacts
data: Domain data
