vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1700,
  "primary": "purpose",
  "themes": [
    "blueprint",
    "compact"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Cedar: from checked rules to controlled effects",
  "kind": "responsibility-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "What does the library prove, and what must the Host enforce?",
      "focusRefs": [
        "sysml",
        "library"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/architecture-overview.d2",
    "sysml": "dev/sysml/architecture.sysml",
    "library": "CedarPooSpec.lean",
    "modelSource": "CedarPooSpec.lean",
    "zeroTrustSource": "CedarPooSpec/ZeroTrust/README.org",
    "verticalControlsSource": "CedarPooSpec/Vertical/Health/README.org",
    "platformProjectionsSource": "CedarPooSpec/Platform/AWS/AgentCore/README.org",
    "productionSource": "Productions/README.org",
    "examplesSource": "Examples/README.org",
    "rustSource": "rust/README.org",
    "hostSource": "Productions/Backend.org"
  },
  "copy": {
    "description": "Read left to right: foundations, reusable controls, independent profiles, then execution.",
    "status": "Arrows are declared dependencies, not runtime order. Zero Trust is a selectable Component. Host IO remains an obligation."
  },
  "presentation": {
    "notation": "components",
    "columns": 4,
    "groups": [
      {
        "title": "What can we trust?",
        "icon": "foundation",
        "subjects": [
          "leanPoo",
          "cedar"
        ],
        "columns": 1
      },
      {
        "title": "Which controls compose?",
        "icon": "puzzle",
        "subjects": [
          "model",
          "zeroTrust",
          "verticalControls",
          "platformProjections"
        ],
        "columns": 2
      },
      {
        "title": "Where are they declared?",
        "icon": "branch",
        "subjects": [
          "production",
          "examples"
        ],
        "columns": 1
      },
      {
        "title": "Who performs the effect?",
        "icon": "gate",
        "subjects": [
          "rust",
          "host"
        ],
        "columns": 1
      }
    ]
  },
  "sysml": {
    "source": "dev/sysml/architecture.sysml",
    "view": "CedarArchitecture::overview",
    "bindings": {
      "leanPoo": {
        "name": "CedarArchitecture::leanPoo",
        "icon": "foundation"
      },
      "cedar": {
        "name": "CedarArchitecture::cedar",
        "icon": "rules"
      },
      "model": {
        "name": "CedarArchitecture::model",
        "icon": "puzzle"
      },
      "zeroTrust": {
        "name": "CedarArchitecture::zeroTrust",
        "icon": "current"
      },
      "verticalControls": {
        "name": "CedarArchitecture::verticalControls",
        "icon": "hospital"
      },
      "platformProjections": {
        "name": "CedarArchitecture::platformProjections",
        "icon": "cloud"
      },
      "production": {
        "name": "CedarArchitecture::production",
        "icon": "gate"
      },
      "examples": {
        "name": "CedarArchitecture::examples",
        "icon": "request"
      },
      "rust": {
        "name": "CedarArchitecture::rust",
        "icon": "evidence"
      },
      "host": {
        "name": "CedarArchitecture::host",
        "icon": "registrar"
      }
    }
  }
}
|
}}}
leanPoo: "LeanPoo\nObjects + Contracts + proofs"
cedar: "Cedar\nAuthorization semantics"
model: "Shared model\nCompose typed controls"
zeroTrust: "Zero Trust\nRecheck every use"
verticalControls: "Industry controls\nHealthcare + finance"
platformProjections: "Platform adapters\nAWS + Google"
production: "Production\nIndependent profile exports"
examples: "Examples\nScenario verification"
rust: "Rust + Python\nSDK replay; native wheels"
host: "Host\nAuthentic facts + actual IO"
leanPoo -> model: "Object + proof APIs"
cedar -> model: "Cedar semantics"
model -> zeroTrust: "Component"
model -> verticalControls: "Industry controls"
model -> platformProjections: "Platform binding"
model -> production: "Profile composition"
model -> examples: "Scenario composition"
zeroTrust -> production: "Use requirements"
zeroTrust -> examples: "Use requirements"
verticalControls -> production: "Industry selection"
platformProjections -> production: "Platform selection"
production -> rust: "Profile exports"
examples -> rust: "Replay inputs"
rust -> host: "Receipts + adapters"
