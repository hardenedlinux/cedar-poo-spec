vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1500,
  "primary": "purpose",
  "themes": [
    "editorial",
    "comfortable"
  ],
  "icons": [
    "engineering",
    "cedar"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Build an application from reusable controls",
  "kind": "responsibility-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "Which controls does my application need?",
      "focusRefs": [
        "sysml",
        "library"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/model-components.d2",
    "sysml": "dev/sysml/architecture.sysml",
    "library": "CedarPooSpec.lean",
    "functionalSource": "CedarPooSpec/Functional/README.org",
    "zeroTrustSource": "CedarPooSpec/ZeroTrust/README.org",
    "authorizationSource": "CedarPooSpec/Authorization/README.org",
    "pseudonymizationSource": "CedarPooSpec/Pseudonymization/README.org",
    "admissionSource": "CedarPooSpec/Admission/README.org",
    "governanceSource": "CedarPooSpec/Governance/README.org",
    "gatewaySource": "CedarPooSpec/Gateway/README.org",
    "dataSource": "CedarPooSpec/Data/README.org",
    "cloudSource": "CedarPooSpec/Cloud/README.org",
    "agenticAISource": "CedarPooSpec/AgenticAI/README.org"
  },
  "copy": {
    "description": "Choose capabilities by responsibility. A profile selects only what it needs.",
    "status": "Library inventory; these groups do not imply execution order or mandatory selection."
  },
  "presentation": {
    "notation": "catalogue",
    "columns": 1,
    "groups": [
      {
        "title": "Define the rules",
        "icon": "rules",
        "subjects": [
          "functional",
          "zeroTrust",
          "authorization"
        ],
        "columns": 3
      },
      {
        "title": "Control operations and information",
        "icon": "gate",
        "subjects": [
          "admission",
          "governance",
          "gateway",
          "pseudonymization",
          "data"
        ],
        "columns": 5
      },
      {
        "title": "Reuse across industries",
        "icon": "cloud",
        "subjects": [
          "cloud",
          "agenticAI"
        ],
        "columns": 2
      }
    ]
  },
  "sysml": {
    "source": "dev/sysml/architecture.sysml",
    "view": "CedarArchitecture::components",
    "bindings": {
      "functional": {
        "name": "CedarArchitecture::functional",
        "icon": "puzzle"
      },
      "zeroTrust": {
        "name": "CedarArchitecture::zeroTrust",
        "icon": "current"
      },
      "authorization": {
        "name": "CedarArchitecture::authorization",
        "icon": "rules"
      },
      "pseudonymization": {
        "name": "CedarArchitecture::pseudonymization",
        "icon": "fingerprint"
      },
      "admission": {
        "name": "CedarArchitecture::admission",
        "icon": "request"
      },
      "governance": {
        "name": "CedarArchitecture::governance",
        "icon": "registrar"
      },
      "gateway": {
        "name": "CedarArchitecture::gateway",
        "icon": "gate"
      },
      "data": {
        "name": "CedarArchitecture::data",
        "icon": "registry"
      },
      "cloud": {
        "name": "CedarArchitecture::cloud",
        "icon": "cloud"
      },
      "agenticAI": {
        "name": "CedarArchitecture::agenticAI",
        "icon": "robot"
      }
    }
  }
}
|
}}}
functional: "Functional Cedar\nTyped Programs + Contracts"
zeroTrust: "Zero Trust\nCurrent-use requirements"
authorization: "Authorization\nPolicy validation + Delta"
pseudonymization: "Pseudonymization\nTransform + correlate + release"
admission: "Admission\nOperation + current inputs"
governance: "Governance\nApprovals + duties + vetoes"
gateway: "Gateway\nBind publication to use"
data: "Data\nSource + destination controls"
cloud: "Cloud\nBuild + release provenance"
agenticAI: "AgenticAI\nDelegation + commerce"
