capabilityGraph: "Reusable capability model\nTyped LeanPoo object"
parentRetention: "Cooperative parent selection\nRetain actual parent sessions"
capabilityIsolation: "Certified capability isolation\nProtected capability roots absent"
traceSafety: "Writer-conditioned output safety\nRequires the supplied writer law"
exactPayment: "Exact payment binding\nNo substituted transaction"
currentGateway: "Current effect mediation\nRecheck before signing"
revoked: "Revocation refusal\nNo new modeled release"
delegationExposure: "Outstanding delegation persists\nLocal pause does not clear authority"
host: "Host trust assumptions\nIdentity + bytes + chain finality"
scenarioMetadata: "Mandatory typed metadata\nPublisher + event + disclosure dates"
scenarioLineage: "Wallet scenario derivation\nRetain exact parent provenance"
incident: "Binance 2026-10-29\nPreliminary report; AI exploit unknown"

deploymentPurpose: "A deployment key is not a signing key\nA deployment-purpose caller is refused"

transferShape: "A payment cannot become code authority\nOnly native transfer; no calldata or delegation"

quarantine: "Existing delegation means quarantine"

stickyPause: "Pause survives every control trace"

retainedBurn: "Recovery retains consumed nonces"

clearNoResume: "Clearing does not resume payments"
