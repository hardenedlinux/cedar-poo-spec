pseudonymization: pseudonymization-google-contract pseudonymization-google-admission
    just build-examples
    timeout --signal=TERM --kill-after=3s 20s lake env lean -M 2048 -T 10000000 Examples/Health/Pseudonymization/Lifecycle.lean
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-tabular > .lake/build/pseudonymization-tabular.json
    cmp .lake/build/pseudonymization-tabular.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-validated > .lake/build/pseudonymization-validated-manifest.json
    jq -e -f Tests/Conformance/pseudonymization-validated-manifest.jq .lake/build/pseudonymization-validated-manifest.json > /dev/null
    cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- replay-validated-receipts < .lake/build/pseudonymization-validated-manifest.json > .lake/build/pseudonymization-validated-receipts.json
    jq -e -f Tests/Conformance/pseudonymization-validated-receipts.jq .lake/build/pseudonymization-validated-receipts.json > /dev/null
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-deployable > .lake/build/pseudonymization-deployable.json
    jq -e -f Tests/Conformance/pseudonymization-deployable.jq .lake/build/pseudonymization-deployable.json > /dev/null
    cargo test --locked -p cedar-poo-pseudonymization-case --features local,google-contract --manifest-path Cargo.toml --test pseudonymization_crypto
    cargo run --locked --quiet -p cedar-poo-pseudonymization-case --features local --manifest-path Cargo.toml --example pseudonymization_local -- .lake/build/pseudonymization-validated-manifest.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json > .lake/build/pseudonymization-local-receipt.json
    jq -e -f Tests/Conformance/pseudonymization-local-receipt.jq .lake/build/pseudonymization-local-receipt.json > /dev/null
    jq '.context = "study-two"' Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json > .lake/build/pseudonymization-wrong-context.json
    ! cargo run --locked --quiet -p cedar-poo-pseudonymization-case --features local --manifest-path Cargo.toml --example pseudonymization_local -- .lake/build/pseudonymization-validated-manifest.json .lake/build/pseudonymization-wrong-context.json > .lake/build/pseudonymization-rejected-output.json
    jq '.tokenKeyVersion = "dek-v2"' Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json > .lake/build/pseudonymization-wrong-key.json
    ! cargo run --locked --quiet -p cedar-poo-pseudonymization-case --features local --manifest-path Cargo.toml --example pseudonymization_local -- .lake/build/pseudonymization-validated-manifest.json .lake/build/pseudonymization-wrong-key.json > .lake/build/pseudonymization-rejected-output.json
    cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- identified-sources hospital-tokenize < .lake/build/pseudonymization-validated-manifest.json > .lake/build/hospital-siv-sources.json
    jq -e -f Tests/Conformance/hospital-siv-sources.jq .lake/build/hospital-siv-sources.json > /dev/null
    jq '[.cases[] | select(.revision == "HospitalSiv")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- render > .lake/build/hospital-siv.cedar
    cmp .lake/build/hospital-siv.cedar Examples/Health/Pseudonymization/Policies/hospital-siv.cedar
    jq '[.cases[] | select(.revision == "RandomizedGcm")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- render > .lake/build/randomized-gcm.cedar
    cmp .lake/build/randomized-gcm.cedar Examples/Health/Pseudonymization/Policies/randomized-gcm.cedar
    jq '[.cases[] | select(.revision == "OneWayHmac")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- render > .lake/build/one-way-hmac.cedar
    cmp .lake/build/one-way-hmac.cedar Examples/Health/Pseudonymization/Policies/one-way-hmac.cedar
    jq '[.cases[] | select(.revision == "AgentIncident")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- render > .lake/build/agent-incident.cedar
    cmp .lake/build/agent-incident.cedar Examples/Health/Pseudonymization/Policies/agent-incident.cedar
    jq '[.cases[] | select(.revision == "ResultRelease")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- render > .lake/build/result-release.cedar
    cmp .lake/build/result-release.cedar Examples/Health/Pseudonymization/Policies/result-release.cedar

