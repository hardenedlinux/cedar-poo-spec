agentic-ai-language-model-disclosure:
    lake build Examples.Health.AgenticAI.LanguageModel.CrossStep Examples.Health.AgenticAI.LanguageModel.DisclosureExport Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean agentic-ai-language-model-health-disclosure > .lake/build/agentic-ai-language-model-health-disclosure-manifest.json
    jq -e '(.cases | length) == 20 and ([.cases[].name] | unique | length) == 20' .lake/build/agentic-ai-language-model-health-disclosure-manifest.json > /dev/null
    cargo run --locked --quiet -p cedar-poo-bridge --manifest-path Cargo.toml -- replay-validated-receipts < .lake/build/agentic-ai-language-model-health-disclosure-manifest.json > .lake/build/agentic-ai-language-model-health-disclosure-receipts.json
    jq -e 'length == 20 and all(.[]; .replay.error_policy_ids == [] and (.schema_sha256 | test("^[0-9a-f]{64}$"))) and ([.[] | select(.replay.decision == "deny") | .replay.case_name] | sort) == ["source-audience-expanded", "source-audience-grant-missing", "source-budget-exhausted", "source-cohort-second-after-first", "source-delegation-missing", "source-delegation-revoked", "source-dropped-label", "source-governed-external", "source-incident", "source-missing-owner", "source-selection-candidates-changed", "source-selection-second-after-first", "source-selection-unobserved", "source-substituted-output"]' .lake/build/agentic-ai-language-model-health-disclosure-receipts.json > /dev/null
    cargo run --locked --quiet -p cedar-poo-disclosure-case --features recovery-replay --manifest-path Cargo.toml --example agentic_ai_language_model_disclosure_host -- .lake/build/agentic-ai-language-model-health-disclosure-manifest.json > .lake/build/agentic-ai-language-model-disclosure-host-receipt.json
    jq -e '.committed.epoch == 1 and .committed.operationId == "release-one" and .committed.authorityId == "approval-first" and .committed.authorityUsed == 1 and .committed.remainingBudget == 1 and .committed.remainingCandidates == 4 and .committed.destination == "DisclosureSink::\"study-workspace\"" and .committed.purpose == "study-one" and .committed.recipients == ["researcher-a"] and .committed.policyRevision == 0 and .auditEntries == 1 and .secondAloneAllowed and .cumulativeSecondDenied and .concurrentSingleCommit and .freshReissueDenied and .crossApprovalReplayDenied and .distinctApprovalAccepted and .duplicateApprovalDenied and .revokedDenied and .audienceChangeDenied and .recipientRevocationDenied and .missingRecipientGrantDenied and .auditFailureDenied and .wrongIssuerDenied and .candidateSubstitutionDenied and .unobservedSelectionDenied and .cumulativeSelectionDenied and .crossChannelRevisionSerialized and .lostReplyCrossChannelRetryDenied and .restartReconciliationAndFencing' .lake/build/agentic-ai-language-model-disclosure-host-receipt.json > /dev/null

pseudonymization-google-contract:
    lake build Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-tabular > .lake/build/pseudonymization-tabular.json
    cmp .lake/build/pseudonymization-tabular.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json
    cargo run --locked --quiet -p cedar-poo-pseudonymization-case --features google-contract --manifest-path Cargo.toml --example pseudonymization_google_contract -- Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json Examples/Health/Pseudonymization/Fixtures/google-deidentify-response.json Examples/Health/Pseudonymization/Fixtures/google-reidentify-response.json > .lake/build/pseudonymization-google-contract-receipt.json
    jq -e -f Tests/Conformance/pseudonymization-google-contract-receipt.jq .lake/build/pseudonymization-google-contract-receipt.json > /dev/null

